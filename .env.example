# Copy to .env and fill in. .env is gitignored.
DEAR_BASE_URL=https://private-anon-486e6ef696-dearinventory.apiary-mock.com
DEAR_ACCOUNT_ID=your-account-id
DEAR_APPLICATION_KEY=your-application-key

# Output directory for fetched purchase orders
OUTPUT_DIR=./purchase-orders

# Max concurrent detail requests. Caps what is in flight and the memory tracking it.
MAX_CONCURRENCY=4

# Client-side call budget. The documented API limit is 60 calls per minute; requests are
# spaced to stay inside it, and a 429 is still retried honouring Retry-After.
CALLS_PER_MINUTE=60
